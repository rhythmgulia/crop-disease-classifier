  "profiles": {
    "apple_scab":{"min_temp_c":3.9,"max_temp_c":25,"min_rh":90,"wetness_hours":6,"description":"Infection needs leaf wetness; about 6 h near 16–24°C, with longer wet periods at cooler or hotter temperatures.","source":"https://extension.psu.edu/tree-fruit-disease-an-apple-scab-review"},
    "apple_black_rot":{"min_temp_c":10,"max_temp_c":32,"min_rh":90,"wetness_hours":6,"description":"Moisture film supports infection; wetness of roughly 5–6 h can permit infection.","source":"https://extension.psu.edu/pome-fruit-disease-black-rot-and-frogeye-leaf-spot"},
    "cedar_apple_rust":{"min_temp_c":null,"max_temp_c":null,"min_rh":90,"wetness_hours":null,"description":"Wet spring conditions and prolonged leaf/fruit wetness favor infection; a numeric temperature range is not specified here.","source":"https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/yard-and-garden-problems/cedar-apple-rust"},
    "cherry_powdery_mildew":{"min_temp_c":21.1,"max_temp_c":26.7,"min_rh":80,"wetness_hours":null,"description":"Warm temperatures (about 21–27°C), high humidity and low rainfall favor disease; free water is not required.","source":"https://ipm.ucanr.edu/agriculture/cherry/powdery-mildew/"},
    "late_blight":{"min_temp_c":15,"max_temp_c":22,"min_rh":95,"wetness_hours":8,"description":"Cool, very humid conditions and persistent dew/wet foliage favor late blight; weather is conducive, not proof of pathogen presence.","source":"https://extension.psu.edu/tomato-potato-late-blight-in-the-home-garden"},
    "early_blight":{"min_temp_c":15,"max_temp_c":30,"min_rh":90,"wetness_hours":null,"description":"Warm, humid weather, dew or free water support spore germination and infection.","source":"https://extension.umn.edu/agriculture/specialty-crops/vegetable-farming/disease-management/early-blight-in-tomato-and-potato"},
    "bacterial_spot":{"min_temp_c":24,"max_temp_c":30,"min_rh":90,"wetness_hours":null,"description":"Warm temperatures, high humidity and frequent rainfall or overhead irrigation favor spread.","source":"https://extension.umn.edu/agriculture/specialty-crops/vegetable-farming/disease-management/bacterial-spot-of-tomato-and-pepper"},
    "tomato_leaf_mold":{"min_temp_c":21.7,"max_temp_c":23.9,"min_rh":85,"wetness_hours":null,"description":"High humidity (>85%) and mild-warm temperatures favor disease development.","source":"https://extension.umn.edu/agriculture/specialty-crops/vegetable-farming/disease-management/tomato-leaf-mold"},
    "septoria_leaf_spot":{"min_temp_c":20,"max_temp_c":25,"min_rh":90,"wetness_hours":null,"description":"Warm conditions and high humidity/leaf moisture favor infection and spread.","source":"https://apps.extension.umn.edu/garden/diagnose/plant/vegetable/tomato/leavesspots.html"},
    "spider_mites":{"min_temp_c":31,"max_temp_c":null,"min_rh":null,"wetness_hours":null,"dry_weather":true,"description":"Hot, dry weather can accelerate mite increase; no quantified humidity threshold is supplied.","source":"https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/how-a-heatwave-affects-gardens"},
    "corn_common_rust":{"min_temp_c":15.6,"max_temp_c":24.4,"min_rh":95,"wetness_hours":6,"description":"Mild temperatures and extended leaf wetness favor infection; hot weather suppresses it.","source":"https://extension.umn.edu/agriculture/crop-production/corn/common-rust-on-corn"},
    "corn_gray_leaf_spot":{"min_temp_c":22,"max_temp_c":30,"min_rh":95,"wetness_hours":24,"description":"Warm conditions plus extended very high humidity/leaf wetness favor gray leaf spot.","source":"https://extension.umn.edu/agriculture/crop-production/corn/gray-leaf-spot-on-corn"},
    "corn_northern_leaf_blight":{"min_temp_c":18,"max_temp_c":27,"min_rh":90,"wetness_hours":null,"description":"Moderate temperatures and prolonged moisture favor infection.","source":"https://extension.umn.edu/agriculture/crop-production/corn/northern-corn-leaf-blight"},
    "grape_black_rot":{"min_temp_c":10,"max_temp_c":32,"min_rh":90,"wetness_hours":6,"description":"Infection requires wetness; the wetness period varies with temperature (about 6–24 h across 10–32°C).","source":"https://extension.psu.edu/grape-disease-black-rot"},
    "grape_leaf_blight":{"min_temp_c":null,"max_temp_c":null,"min_rh":90,"wetness_hours":null,"description":"High humidity and long leaf-wetness periods favor grape foliar disease; no precise Isariopsis threshold is encoded.","source":"https://blog-fruit-vegetable-ipm.extension.umn.edu/2026/05/grape-foliar-and-fruit-diseases-early.html"},
    "peach_bacterial_spot":{"min_temp_c":24,"max_temp_c":29.4,"min_rh":90,"wetness_hours":null,"description":"Warm, wet weather favors bacterial spot development and spread.","source":"https://extension.psu.edu/managing-orchards-in-a-no-crop-year-protecting-tree-health-for-next-season"},
    "powdery_mildew":{"min_temp_c":20,"max_temp_c":27.2,"min_rh":70,"wetness_hours":null,"description":"Mild-warm humid nights support infection/spore production; dry warm periods can aid spread. Rainfall is not required.","source":"https://extension.umn.edu/agriculture/specialty-crops/vegetable-farming/disease-management/powdery-mildew-of-cucurbits"},
    "tomato_target_spot":{"min_temp_c":15.6,"max_temp_c":32.2,"min_rh":90,"wetness_hours":16,"description":"Infection favors 16–32°C and high humidity with 16–44 hours of continuous leaf wetness; the 24-hour forecast can only flag partial exposure.","source":"https://ask.ifas.ufl.edu/publication/PP351/pdf"},
    "strawberry_leaf_scorch":{"min_temp_c":null,"max_temp_c":null,"min_rh":90,"wetness_hours":12,"description":"Leaf wetness for at least about 12 h supports infection; a numeric temperature range is not specified.","source":"https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/growing-strawberries-in-the-home-garden"}
  }
