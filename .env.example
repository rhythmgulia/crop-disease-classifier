# Sarvam AI Subscription Key (Kept strictly on the backend, never exposed to frontend)
# Used for Saaras v4 (STT), Bulbul v4-flash (TTS), and Mayura v1 (Translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Database Connection (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./cropdisease.db

# Set stable, private values in the backend environment for multi-restart sessions
AUTH_SECRET=replace_with_a_long_random_secret
AGRONOMIST_INVITE_CODE=replace_with_a_private_invitation_code

# Frontend API URL (leave blank to use Vite development server proxy)
VITE_API_URL=
